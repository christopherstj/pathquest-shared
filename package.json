{
  "name": "@pathquest/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types + API client helpers for PathQuest web + native.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "default": "./dist/util/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@pathquest/shared": "github:christopherstj/pathquest-shared#bf010e65b47273d3b71f17724371bcb018560aa9",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
